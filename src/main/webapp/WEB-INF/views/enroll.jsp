<%@ page contentType="text/html;charset=UTF-8" language="java" trimDirectiveWhitespaces="true" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<c:set var="pageTitle" value="Enroll Patient"/>
<c:set var="nav" value="enroll"/>
<%@ include file="_header.jsp" %>

<div class="page-head">
    <div>
        <h1>Enroll Patient into a Trial <span class="tag">Validation Rules</span></h1>
        <p>Consent and eligibility checks, site capacity validation, balanced treatment allocation and visit scheduling run during enrollment.</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="panel">
            <h2>Enrollment Form</h2>
            <form method="post" action="${ctx}/enrollPatient">
                <div class="mb-3">
                    <label class="form-label">Patient *</label>
                    <select name="patient_id" class="form-select" required>
                        <option value="">-- Select patient --</option>
                        <c:forEach var="p" items="${patients}">
                            <option value="${p.patient_id}">
                                #${p.patient_id} - <c:out value="${p.name}"/> (consent: ${p.consent_status})<c:if test="${not empty p.trial_name}"> - already in <c:out value="${p.trial_name}"/></c:if>
                            </option>
                        </c:forEach>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Trial / Investigative Site *</label>
                    <select name="trial_site_id" class="form-select" required>
                        <option value="">-- Select trial and site --</option>
                        <c:forEach var="t" items="${trialSites}">
                            <option value="${t.trial_site_id}" ${t.status != 'Active' ? 'disabled' : ''}>
                                <c:out value="${t.trial_name}"/> - Phase ${t.phase} | <c:out value="${t.site_code}"/>
                                (${t.enrolled}/${t.site_target}) [${t.status}]
                            </option>
                        </c:forEach>
                    </select>
                </div>
                <div class="alert alert-info small">Enrollment automatically assigns an allocation arm using a secure random choice among the least-filled arms, then creates Baseline, Week 4, Week 12 and Week 24 visits.</div>
                <button type="submit" class="btn btn-teal"><i class="bi bi-person-check"></i> Enroll &amp; Randomize</button>
            </form>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="panel">
            <h2>Validation Rules</h2>
            <ol class="rule-list ps-3">
                <li><strong>Consent check:</strong> consent status must be <em>Obtained</em>.</li>
                <li><strong>Trial status check:</strong> the trial must be <em>Active</em> (Suspended, Completed and Pending trials are blocked).</li>
                <li><strong>Duplicate check:</strong> a patient cannot be enrolled in more than one trial.</li>
                <li><strong>Site capacity:</strong> the trial and site enrollment targets cannot be exceeded.</li>
                <li><strong>Randomization:</strong> assignment is generated by the system, not selected by staff.</li>
                <li><strong>Visit plan:</strong> four protocol visits are created automatically.</li>
            </ol>
            <p class="sub mb-0">Only when all three checks pass is the patient enrolled and a consent record created.</p>
        </div>
    </div>
</div>
<%@ include file="_footer.jsp" %>
